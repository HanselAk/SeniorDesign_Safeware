def build_recent_alerts():
    """Combine the three hardware alert logs for the new dashboard."""
    combined = []

    for alert in state["alerts"]:
        combined.append({
            "type": "FALL",
            "message": f"Fall detected - impact {alert['smv']} m/sÂ²",
            "severity": "critical",
            "time": alert["time"],
            "lat": alert["lat"],
            "lon": alert["lon"],
        })

    for alert in state["temp_alerts"]:
        combined.append({
            "type": "HEAT",
            "message": f"High temperature - {alert['temp_f']} Â°F",
            "severity": "critical",
            "time": alert["time"],
            "lat": alert["lat"],
            "lon": alert["lon"],
        })

    for alert in state["hr_alerts"]:
        combined.append({
            "type": "HEART RATE",
            "message": f"High heart rate - {alert['bpm']} BPM",
            "severity": "critical",
            "time": alert["time"],
            "lat": alert["lat"],
            "lon": alert["lon"],
        })

    return sorted(combined, key=lambda item: item["time"], reverse=True)[:MAX_ALERTS]


@app.route("/")
def index():
    return render_template("dashboard.html")

@app.route("/api/state")
def api_state():
    with state_lock:
        if state["temp_f"] > 0:
            temp_history.append(state["temp_f"])
        if state["hr_bpm"] > 0:
            hr_history.append(state["hr_bpm"])

        snapshot = dict(state)
        snapshot["temp_history"] = list(temp_history)
        snapshot["hr_history"] = list(hr_history)
        snapshot["recent_alerts"] = build_recent_alerts()
        snapshot["connected"] = True

        if state["fall_active"] or state["temp_alert"] or state["hr_alert"]:
            snapshot["overall_status"] = "EMERGENCY"
        elif state["helmet_on"] is False or state["vest_on"] is False:
            snapshot["overall_status"] = "WARNING"
        else:
            snapshot["overall_status"] = "SAFE"

        return jsonify(snapshot)

