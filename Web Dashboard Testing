def mjpeg_generator():
    global latest_jpeg
    while True:
        with frame_lock:
            frame = latest_jpeg
        if frame:
            yield (b"--frame\r\nContent-Type: image/jpeg\r\n\r\n" + frame + b"\r\n")
        time.sleep(0.03)

@app.route("/api/acknowledge_hr", methods=["POST"])
