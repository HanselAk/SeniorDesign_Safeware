<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Safeware PDR</title>
<style>
:root{--bg:#0b0f14;--panel:#141b23;--line:#25303b;--text:#e6edf3;--mute:#7d8b99;--accent:#22d3ee;--good:#3fb950}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif}
.app{display:grid;grid-template-rows:auto 1fr;height:100%}
header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px}
.logo{width:30px;height:30px;border-radius:8px;background:linear-gradient(135deg,#3b82f6,#22d3ee);display:flex;align-items:center;justify-content:center;font-weight:800;color:#04121f}
.title{font-weight:700}
.sub{font-size:12px;color:var(--mute)}
.conn{font-size:12px;color:var(--mute);display:flex;align-items:center;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;background:#d64545}
.dot.ok{background:var(--good);box-shadow:0 0 8px var(--good)}
main{display:grid;grid-template-columns:1fr 310px;min-height:0}
.mapwrap{position:relative;min-height:0}
canvas{width:100%;height:100%;display:block;cursor:grab;touch-action:none}
.mapbtns{position:absolute;top:12px;right:12px;display:flex;flex-direction:column;gap:6px}
.scale{position:absolute;left:12px;bottom:12px;font-size:11px;color:var(--mute)}
.scale i{display:block;height:5px;border:1px solid var(--mute);border-top:0;margin-bottom:4px}
aside{border-left:1px solid var(--line);padding:14px;overflow:auto;display:flex;flex-direction:column;gap:12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px}
.label{font-size:10px;color:var(--mute);text-transform:uppercase;letter-spacing:.08em}
.val{font-size:22px;font-weight:700;margin-top:4px;display:flex;align-items:center}
.unit{font-size:12px;color:var(--mute);margin-left:3px;font-weight:500}
.status{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#222c36;color:var(--mute);margin-top:6px}
.status.walk{background:#1f6f43;color:#d6ffe6}
.status.cal{background:#7a4b0b;color:#ffe7c2}
button,select,input{background:#1b242e;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font:inherit;font-size:13px}
button{cursor:pointer}
button:hover{border-color:var(--accent)}
button.primary{background:var(--accent);color:#04121f;border-color:var(--accent);font-weight:600}
button.on{border-color:var(--accent);color:var(--accent)}
.row{display:flex;gap:8px;align-items:center;margin-top:8px}
.row input,.row select{flex:1;min-width:0}
.hint{font-size:11px;color:var(--mute);margin-top:6px}
.arrow{width:18px;height:18px;margin-left:8px;transition:transform .15s}
.sp{display:flex;align-items:center;gap:8px;margin-top:6px;font-size:11px;color:var(--mute)}
.bar{flex:1;height:6px;background:#222c36;border-radius:3px;overflow:hidden}
.fill{height:100%;width:0;background:var(--accent);transition:width .3s}
@media (max-width:760px){.app{height:auto}main{grid-template-columns:1fr;grid-template-rows:60vh auto}aside{border-left:0;border-top:1px solid var(--line)}}
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand">
      <div class="logo">S</div>
      <div><div class="title">Safeware PDR</div><div class="sub">live position from the ESP32 wearable, computed on the Jetson &middot; <a href="/" style="color:var(--accent)">Dashboard</a></div></div>
    </div>
    <div class="conn"><span id="dot" class="dot"></span><span id="conn">connecting</span></div>
  </header>
  <main>
    <div class="mapwrap">
      <canvas id="map"></canvas>
      <div class="mapbtns">
        <button id="zin">+</button>
        <button id="zout">-</button>
        <button id="fit">Fit</button>
        <button id="follow">Follow</button>
      </div>
      <div class="scale"><i id="sbar"></i><span id="slabel">1 m</span></div>
    </div>
    <aside>
      <div class="card">
        <div class="label">Status</div>
        <span id="status" class="status">connecting</span>
      </div>
      <div class="grid">
        <div class="card"><div class="label">Steps</div><div class="val" id="steps">0</div></div>
        <div class="card"><div class="label">Distance</div><div class="val"><span id="dist">0.0</span><span class="unit">m</span></div></div>
        <div class="card"><div class="label">Heading</div><div class="val"><span id="hdg">0</span><span class="unit">&deg;</span><svg id="harrow" class="arrow" viewBox="0 0 20 20"><path d="M10 2 L16 17 L10 13 L4 17 Z" fill="#22d3ee"/></svg></div></div>
        <div class="card"><div class="label">Position</div><div class="val" style="font-size:16px"><span id="pos">0.0, 0.0</span><span class="unit">m</span></div></div>
      </div>
      <div class="card">
        <div class="label">Controls</div>
        <div class="row"><button class="primary" id="reset" style="flex:1">Reset position</button><button id="cal" style="flex:1">Recalibrate gyro</button></div>
        <div class="hint">Face your walking direction before Reset. Gyro calibration needs the sensor still for 2 seconds.</div>
      </div>
      <div class="card">
        <div class="label">Magnetometer</div>
        <span id="magstat" class="status">-</span>
        <div class="grid" style="margin-top:10px">
          <div><div class="label">Field</div><div class="val" style="font-size:18px"><span id="bval">0</span><span class="unit">&micro;T</span></div></div>
          <div><div class="label">Mag heading</div><div class="val" style="font-size:18px"><span id="mhval">0</span><span class="unit">&deg;</span></div></div>
        </div>
        <div id="calbox" style="display:none;margin-top:10px">
          <div class="hint">Rotate the sensor through every orientation until all three bars fill.</div>
          <div class="sp"><span>X</span><div class="bar"><div id="spx" class="fill"></div></div></div>
          <div class="sp"><span>Y</span><div class="bar"><div id="spy" class="fill"></div></div></div>
          <div class="sp"><span>Z</span><div class="bar"><div id="spz" class="fill"></div></div></div>
        </div>
        <div class="row"><button id="fuse" style="flex:1">Fusion: On</button><button id="magcal" style="flex:1">Calibrate</button></div>
        <div class="hint" id="mmsg"></div>
      </div>
      <div class="card">
        <div class="label">Step length (m)</div>
        <div class="row"><input id="len" type="number" min="0.3" max="1.2" step="0.01" value="0.70"><button id="lenset">Apply</button></div>
        <div class="label" style="margin-top:12px">Heading snap</div>
        <div class="row"><select id="snap"><option value="0">Off</option><option value="45">45&deg;</option><option value="90">90&deg;</option></select></div>
        <div class="hint">Snap keeps paths straight in hallways and grid-like rooms.</div>
      </div>
    </aside>
  </main>
</div>
<script>
const $ = id => document.getElementById(id);
const cv = $('map'), ctx = cv.getContext('2d');
let trail = [[0,0]], cur = {x:0,y:0,h:0,walk:false}, sess = -1, next = 0, curFuse = true;
let view = {cx:0, cy:0, scale:40}, follow = true, online = false;

function resize(){
  const r = cv.getBoundingClientRect(), d = window.devicePixelRatio || 1;
  cv.width = r.width * d; cv.height = r.height * d;
  ctx.setTransform(d,0,0,d,0,0);
}
window.addEventListener('resize', resize); resize();

const W = () => cv.clientWidth, H = () => cv.clientHeight;
const toS = (x,y) => [W()/2 + (x - view.cx)*view.scale, H()/2 - (y - view.cy)*view.scale];

function gridStep(){
  for (const o of [0.5,1,2,5,10,20,50]) if (o*view.scale >= 40) return o;
  return 100;
}

function draw(){
  const w = W(), h = H();
  if (follow){ view.cx += (cur.x - view.cx)*0.15; view.cy += (cur.y - view.cy)*0.15; }
  ctx.clearRect(0,0,w,h);

  const st = gridStep();
  const x0 = view.cx - w/2/view.scale, x1 = view.cx + w/2/view.scale;
  const y0 = view.cy - h/2/view.scale, y1 = view.cy + h/2/view.scale;
  ctx.lineWidth = 1; ctx.font = '10px system-ui'; ctx.fillStyle = '#51606d';
  for (let i = Math.floor(x0/st); i*st <= x1; i++){
    const [sx] = toS(i*st, 0);
    ctx.strokeStyle = i === 0 ? '#2f4a5e' : (i % 5 === 0 ? '#1f2a35' : '#151d26');
    ctx.beginPath(); ctx.moveTo(sx,0); ctx.lineTo(sx,h); ctx.stroke();
    if (i % 5 === 0) ctx.fillText((i*st) + ' m', sx + 3, h - 6);
  }
  for (let i = Math.floor(y0/st); i*st <= y1; i++){
    const [, sy] = toS(0, i*st);
    ctx.strokeStyle = i === 0 ? '#2f4a5e' : (i % 5 === 0 ? '#1f2a35' : '#151d26');
    ctx.beginPath(); ctx.moveTo(0,sy); ctx.lineTo(w,sy); ctx.stroke();
    if (i % 5 === 0 && i !== 0) ctx.fillText((i*st) + ' m', 4, sy - 3);
  }

  if (trail.length > 1){
    ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 2.5; ctx.lineJoin = 'round';
    ctx.beginPath();
    trail.forEach((p,i) => { const [sx,sy] = toS(p[0],p[1]); i ? ctx.lineTo(sx,sy) : ctx.moveTo(sx,sy); });
    ctx.stroke();
    ctx.fillStyle = 'rgba(34,211,238,.5)';
    for (const p of trail){ const [sx,sy] = toS(p[0],p[1]); ctx.beginPath(); ctx.arc(sx,sy,2,0,7); ctx.fill(); }
  }

  if (trail.length){
    const [sx,sy] = toS(trail[0][0], trail[0][1]);
    ctx.fillStyle = '#1f6f43'; ctx.strokeStyle = '#3fb950'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(sx,sy,8,0,7); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#d6ffe6'; ctx.font = 'bold 9px system-ui'; ctx.textAlign = 'center';
    ctx.fillText('S', sx, sy + 3); ctx.textAlign = 'left';
  }

  const [px,py] = toS(cur.x, cur.y), a = cur.h * Math.PI / 180;
  if (cur.walk){
    const t = (performance.now() % 1200) / 1200;
    ctx.strokeStyle = `rgba(63,185,80,${1-t})`; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(px,py,10 + t*18,0,7); ctx.stroke();
  }
  ctx.save(); ctx.translate(px,py); ctx.rotate(a);
  const g = ctx.createRadialGradient(0,0,0,0,0,60);
  g.addColorStop(0,'rgba(59,130,246,.35)'); g.addColorStop(1,'rgba(59,130,246,0)');
  ctx.fillStyle = g; ctx.beginPath(); ctx.moveTo(0,0);
  ctx.arc(0,0,60,-Math.PI/2 - 0.45,-Math.PI/2 + 0.45); ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#3b82f6'; ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.arc(0,0,9,0,7); ctx.fill(); ctx.stroke();
  ctx.fillStyle = '#fff'; ctx.beginPath();
  ctx.moveTo(0,-6); ctx.lineTo(4,3); ctx.lineTo(0,1); ctx.lineTo(-4,3); ctx.closePath(); ctx.fill();
  ctx.restore();

  $('sbar').style.width = (st * view.scale) + 'px';
  $('slabel').textContent = st + ' m';
  requestAnimationFrame(draw);
}

let drag = null;
cv.addEventListener('pointerdown', e => {
  drag = {x:e.clientX, y:e.clientY, cx:view.cx, cy:view.cy};
  cv.setPointerCapture(e.pointerId); follow = false; updFollow(); cv.style.cursor = 'grabbing';
});
cv.addEventListener('pointermove', e => {
  if (!drag) return;
  view.cx = drag.cx - (e.clientX - drag.x)/view.scale;
  view.cy = drag.cy + (e.clientY - drag.y)/view.scale;
});
cv.addEventListener('pointerup', () => { drag = null; cv.style.cursor = 'grab'; });
cv.addEventListener('wheel', e => { e.preventDefault(); zoom(e.deltaY < 0 ? 1.2 : 1/1.2); }, {passive:false});
function zoom(f){ view.scale = Math.min(300, Math.max(4, view.scale*f)); }
function updFollow(){ $('follow').className = follow ? 'on' : ''; }
function fit(){
  const xs = trail.map(p => p[0]).concat(cur.x), ys = trail.map(p => p[1]).concat(cur.y);
  const mnx = Math.min(...xs), mxx = Math.max(...xs), mny = Math.min(...ys), mxy = Math.max(...ys);
  view.cx = (mnx + mxx)/2; view.cy = (mny + mxy)/2;
  view.scale = Math.min(300, Math.max(4, Math.min(W()/(mxx - mnx + 4), H()/(mxy - mny + 4))));
  follow = false; updFollow();
}
$('zin').onclick = () => zoom(1.3);
$('zout').onclick = () => zoom(1/1.3);
$('fit').onclick = fit;
$('follow').onclick = () => { follow = !follow; updFollow(); };

const post = (url, body) => fetch(url, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body || {})});
$('reset').onclick = () => post('/api/pdr/reset').then(() => { view.cx = 0; view.cy = 0; follow = true; updFollow(); });
$('cal').onclick = () => post('/api/pdr/calibrate');
$('lenset').onclick = () => post('/api/pdr/set', {len: Number($('len').value)});
$('snap').onchange = () => post('/api/pdr/set', {snap: Number($('snap').value)});
$('fuse').onclick = () => post('/api/pdr/set', {fuse: !curFuse});
$('magcal').onclick = () => post('/api/pdr/magcal');

async function poll(){
  try {
    const r = await fetch(`/api/pdr?from=${next}&s=${sess}`, {cache:'no-store'});
    const j = await r.json();
    if (j.s !== sess){ sess = j.s; trail = []; }
    for (const p of j.pts) trail.push(p);
    if (trail.length > 5000) trail.splice(0, trail.length - 5000);
    next = j.next;
    cur = {x:j.x, y:j.y, h:j.h, walk:j.walk};

    $('steps').textContent = j.steps;
    $('dist').textContent = j.dist.toFixed(1);
    $('hdg').textContent = Math.round(j.h);
    $('harrow').style.transform = `rotate(${j.h}deg)`;
    $('pos').textContent = `${j.x.toFixed(1)}, ${j.y.toFixed(1)}`;

    const s = $('status');
    if (!j.online){ s.textContent = 'Wearable offline'; s.className = 'status cal'; }
    else if (!j.imu){ s.textContent = 'IMU not responding'; s.className = 'status cal'; }
    else if (j.cal){ s.textContent = 'Calibrating gyro, hold still'; s.className = 'status cal'; }
    else if (j.walk){ s.textContent = 'Walking'; s.className = 'status walk'; }
    else { s.textContent = 'Standing'; s.className = 'status'; }

    curFuse = j.fuse;
    const ms = $('magstat');
    if (!j.magok){ ms.textContent = 'Not detected'; ms.className = 'status cal'; }
    else if (j.mcal >= 0){ ms.textContent = `Calibrating: rotate, ${j.mcal}s left`; ms.className = 'status cal'; }
    else if (!j.fuse){ ms.textContent = 'Off, gyro only'; ms.className = 'status'; }
    else if (j.mag === 1){ ms.textContent = 'Fused with gyro'; ms.className = 'status walk'; }
    else if (j.mag === 2){ ms.textContent = 'Disturbed, gyro only'; ms.className = 'status cal'; }
    else { ms.textContent = 'Waiting for data'; ms.className = 'status'; }
    $('bval').textContent = j.b.toFixed(1);
    $('mhval').textContent = Math.round(j.mh);
    $('fuse').textContent = 'Fusion: ' + (j.fuse ? 'On' : 'Off');
    $('fuse').className = j.fuse ? 'on' : '';
    $('calbox').style.display = j.mcal >= 0 ? 'block' : 'none';
    ['spx','spy','spz'].forEach((id,i) => { $(id).style.width = Math.min(100, j.msp[i] / 90 * 100) + '%'; });
    $('mmsg').textContent = j.mmsg;

    if (document.activeElement !== $('len')) $('len').value = j.len.toFixed(2);
    if (document.activeElement !== $('snap')) $('snap').value = j.snap;
    online = true;
  } catch(e){ online = false; }
  $('dot').className = 'dot' + (online ? ' ok' : '');
  $('conn').textContent = online ? 'connected' : 'offline';
  setTimeout(poll, 150);
}

updFollow(); poll(); requestAnimationFrame(draw);
</script>
</body>
</html>
