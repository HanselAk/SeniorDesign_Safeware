// ============================================================
//  esp32_safeware.ino  -  Safeware wearable, generic ESP32 + MPU9250
//
//  The ESP32 only collects data: it reads accel, gyro and magnetometer at
//  100 Hz and streams the raw samples over WiFi to server_dashboard.py on the
//  Jetson (POST /api/imu). Gyro calibration, heading, magnetometer fusion and
//  calibration, step detection, position (PDR) and fall detection all run on
//  the Jetson. The live map is at http://<jetson-ip>:5000/pdr
//
//  Wiring: VCC=3V3, GND=GND, SDA=GPIO21, SCL=GPIO22, AD0=GND (address 0x68).
//  Libraries: only the ESP32 Arduino core (WiFi, HTTPClient, Wire).
//
//  Sensing runs in loop() on core 1, networking runs on core 0, so a slow
//  HTTP request never makes the sensor miss samples. Samples wait in a ring
//  buffer (about 5 s) and are only removed once the Jetson accepts them.
// ============================================================
#include <WiFi.h>
#include <HTTPClient.h>
#include <Wire.h>

// ================= USER SETTINGS =================
const char* WIFI_SSID  = "";
const char* WIFI_PASS  = "";
const char* SERVER_URL = "http://10.74.52.106:5000/api/imu";  // Jetson IP: run `hostname -I` on it
const char* API_TOKEN  = "";             // must match SAFEWARE_TOKEN on the Jetson; empty = no token
const char* DEVICE_ID  = "esp32-01";
const int SDA_PIN = 21;
const int SCL_PIN = 22;
const unsigned long SEND_MS = 100;       // 10 posts per second, ~10 samples each
// =================================================

#define MPU 0x68
#define MAG 0x0C

// One 100 Hz reading. Accel in g, gyro in deg/s, mag in uT (sensor axes, uncalibrated).
struct Sample {
  uint32_t us;
  float a[3], g[3], m[3];
  bool hasMag;
};

const uint32_t BUF_SIZE = 512;
const uint32_t MAX_BATCH = 60;
Sample buf[BUF_SIZE];
volatile uint32_t head = 0, tail = 0;    // head: written by loop(), tail: advanced by netTask
volatile uint32_t dropped = 0;           // samples lost because the buffer was full
portMUX_TYPE bufMux = portMUX_INITIALIZER_UNLOCKED;

volatile bool imuOk = false, magOk = false;
float asa[3] = {1, 1, 1};                // magnetometer factory sensitivity adjustment
uint32_t bootId = 0;                     // lets the Jetson notice a reboot and recalibrate
unsigned long lastUs = 0;

// ---------------- I2C helpers ----------------
void writeReg(uint8_t a, uint8_t r, uint8_t v) {
  Wire.beginTransmission(a);
  Wire.write(r);
  Wire.write(v);
  Wire.endTransmission();
}

bool readRegs(uint8_t a, uint8_t r, uint8_t *b, uint8_t n) {
  Wire.beginTransmission(a);
  Wire.write(r);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)a, (uint8_t)n) != n) return false;
  for (uint8_t i = 0; i < n; i++) b[i] = Wire.read();
  return true;
}

// ---------------- Sensors ----------------
bool initIMU() {
  writeReg(MPU, 0x6B, 0x80); delay(100);  // reset
  writeReg(MPU, 0x6B, 0x01); delay(50);   // wake
  writeReg(MPU, 0x1A, 0x03);              // gyro low-pass ~41 Hz
  writeReg(MPU, 0x19, 0x09);              // 100 Hz
  writeReg(MPU, 0x1B, 0x08);              // gyro +/-500 dps
  writeReg(MPU, 0x1C, 0x10);              // accel +/-8 g, so fall impacts do not clip
  writeReg(MPU, 0x1D, 0x03);              // accel low-pass ~44 Hz
  uint8_t who = 0;
  return readRegs(MPU, 0x75, &who, 1);
}

bool initMag() {
  writeReg(MPU, 0x6A, 0x00);              // internal I2C master off
  writeReg(MPU, 0x37, 0x02); delay(10);   // bypass: magnetometer on main bus
  writeReg(MAG, 0x0B, 0x01); delay(10);   // soft reset
  uint8_t wia = 0;
  if (!readRegs(MAG, 0x00, &wia, 1) || wia != 0x48) return false;
  writeReg(MAG, 0x0A, 0x00); delay(10);
  writeReg(MAG, 0x0A, 0x0F); delay(10);   // fuse ROM access
  uint8_t raw[3];
  readRegs(MAG, 0x10, raw, 3);
  for (int i = 0; i < 3; i++) asa[i] = (raw[i] - 128) * 0.5f / 128.0f + 1.0f;
  writeReg(MAG, 0x0A, 0x00); delay(10);
  writeReg(MAG, 0x0A, 0x16); delay(10);   // continuous 100 Hz, 16-bit
  return true;
}

bool readIMU(float a[3], float g[3]) {
  uint8_t d[14];
  if (!readRegs(MPU, 0x3B, d, 14)) return false;
  for (int i = 0; i < 3; i++) {
    a[i] = (int16_t)((d[i * 2] << 8) | d[i * 2 + 1]) / 4096.0f;   // +/-8 g
    g[i] = (int16_t)((d[8 + i * 2] << 8) | d[9 + i * 2]) / 65.5f;  // +/-500 dps
  }
  return true;
}

bool readMagUT(float ut[3]) {
  uint8_t st1 = 0;
  if (!readRegs(MAG, 0x02, &st1, 1) || !(st1 & 0x01)) return false;
  uint8_t d[7];
  if (!readRegs(MAG, 0x03, d, 7)) return false;
  if (d[6] & 0x08) return false;          // overflow
  for (int i = 0; i < 3; i++)
    ut[i] = (int16_t)((d[i * 2 + 1] << 8) | d[i * 2]) * asa[i] * 0.15f;
  return true;
}

// ---------------- Ring buffer ----------------
void pushSample(const Sample &s) {
  portENTER_CRITICAL(&bufMux);
  if (head - tail >= BUF_SIZE) {          // full: drop the oldest sample
    tail++;
    dropped++;
  }
  buf[head % BUF_SIZE] = s;
  head++;
  portEXIT_CRITICAL(&bufMux);
}

// ---------------- Network task (core 0) ----------------
Sample batch[MAX_BATCH];
char body[MAX_BATCH * 96 + 192];

size_t buildBody(uint32_t n) {
  size_t len = snprintf(body, sizeof(body),
    "{\"device\":\"%s\",\"boot\":%lu,\"imu\":%s,\"mag\":%s,\"dropped\":%lu,\"s\":[",
    DEVICE_ID, (unsigned long)bootId, imuOk ? "true" : "false", magOk ? "true" : "false",
    (unsigned long)dropped);
  for (uint32_t i = 0; i < n && len < sizeof(body); i++) {
    const Sample &s = batch[i];
    len += snprintf(body + len, sizeof(body) - len, "%s[%lu,%.4f,%.4f,%.4f,%.2f,%.2f,%.2f",
                    i ? "," : "", (unsigned long)s.us, s.a[0], s.a[1], s.a[2], s.g[0], s.g[1], s.g[2]);
    if (s.hasMag && len < sizeof(body))
      len += snprintf(body + len, sizeof(body) - len, ",%.1f,%.1f,%.1f", s.m[0], s.m[1], s.m[2]);
    if (len < sizeof(body)) len += snprintf(body + len, sizeof(body) - len, "]");
  }
  if (len < sizeof(body)) len += snprintf(body + len, sizeof(body) - len, "]}");
  return len < sizeof(body) ? len : 0;
}

void netTask(void*) {
  WiFiClient client;
  HTTPClient http;
  http.setReuse(true);
  unsigned long lastSend = 0, lastReconnect = 0, lastPrint = 0;
  int code = 0;

  for (;;) {
    unsigned long now = millis();
    if (now - lastPrint > 2000) {
      lastPrint = now;
      Serial.printf("wifi %s | imu %s mag %s | last http %d | buffered %lu dropped %lu\n",
                    WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString().c_str() : "down",
                    imuOk ? "ok" : "FAIL", magOk ? "ok" : "none", code,
                    (unsigned long)(head - tail), (unsigned long)dropped);
    }

    if (WiFi.status() != WL_CONNECTED) {
      if (now - lastReconnect > 3000) {
        lastReconnect = now;
        WiFi.reconnect();
      }
      vTaskDelay(pdMS_TO_TICKS(250));
      continue;
    }
    if (now - lastSend < SEND_MS) {
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }
    lastSend = now;

    // Copy a batch out without removing it, so it is resent if the POST fails.
    portENTER_CRITICAL(&bufMux);
    uint32_t start = tail;
    uint32_t n = head - tail;
    if (n > MAX_BATCH) n = MAX_BATCH;
    for (uint32_t i = 0; i < n; i++) batch[i] = buf[(start + i) % BUF_SIZE];
    portEXIT_CRITICAL(&bufMux);

    size_t len = buildBody(n);
    if (len == 0) continue;

    http.begin(client, SERVER_URL);
    http.setConnectTimeout(800);
    http.setTimeout(1000);
    http.addHeader("Content-Type", "application/json");
    if (API_TOKEN[0]) http.addHeader("X-Safeware-Token", API_TOKEN);
    code = http.POST((uint8_t*)body, len);
    http.end();

    if (code == 200) {
      portENTER_CRITICAL(&bufMux);
      if ((int32_t)(start + n - tail) > 0) tail = start + n;   // tail may have moved if the buffer overflowed
      portEXIT_CRITICAL(&bufMux);
    }
  }
}

// ---------------- Main ----------------
void setup() {
  Serial.begin(115200);
  delay(500);
  bootId = (uint32_t)random(1, 2147483647);   // hardware RNG on ESP32

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);
  imuOk = initIMU();
  magOk = imuOk && initMag();
  if (!imuOk) Serial.println("IMU not responding. Check wiring.");
  else if (!magOk) Serial.println("Magnetometer not found. Heading will be gyro only.");

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);                   // lower latency
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  xTaskCreatePinnedToCore(netTask, "net", 8192, nullptr, 1, nullptr, 0);

  Serial.println("Streaming to the Jetson. Hold the sensor still for 2 s after boot (gyro calibration).");
  lastUs = micros();
}

void loop() {
  unsigned long nowUs = micros();
  if (nowUs - lastUs < 10000) return;     // 100 Hz
  lastUs = nowUs;

  Sample s;
  if (!readIMU(s.a, s.g)) {
    imuOk = false;
    static unsigned long lastInit = 0;
    if (millis() - lastInit > 1000) {
      lastInit = millis();
      imuOk = initIMU();
      if (imuOk) magOk = initMag();
    }
    return;
  }
  imuOk = true;
  s.us = nowUs;
  s.hasMag = magOk && readMagUT(s.m);
  pushSample(s);
}
