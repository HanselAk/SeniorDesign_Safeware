<script>
const $ = id => document.getElementById(id);
const cv = $('map'), ctx = cv.getContext('2d');
let trail = [[0,0]], cur = {x:0,y:0,h:0,walk:false}, sess = -1, next = 0, curFuse = true;
let view = {cx:0, cy:0, scale:40}, follow = true, online = false;

function resize(){
  const r = cv.getBoundingClientRect(), d = window.devicePixelRatio || 1;
  cv.width = r.width * d; cv.height = r.height * d;
  ctx.setTransform(d,0,0,d,0,0);
}
window.addEventListener('resize', resize); resize();

const W = () => cv.clientWidth, H = () => cv.clientHeight;
const toS = (x,y) => [W()/2 + (x - view.cx)*view.scale, H()/2 - (y - view.cy)*view.scale];

function gridStep(){
  for (const o of [0.5,1,2,5,10,20,50]) if (o*view.scale >= 40) return o;
  return 100;
}

function draw(){
  const w = W(), h = H();
  if (follow){ view.cx += (cur.x - view.cx)*0.15; view.cy += (cur.y - view.cy)*0.15; }
  ctx.clearRect(0,0,w,h);

  const st = gridStep();
  const x0 = view.cx - w/2/view.scale, x1 = view.cx + w/2/view.scale;
  const y0 = view.cy - h/2/view.scale, y1 = view.cy + h/2/view.scale;
  ctx.lineWidth = 1; ctx.font = '10px system-ui'; ctx.fillStyle = '#51606d';
  for (let i = Math.floor(x0/st); i*st <= x1; i++){
    const [sx] = toS(i*st, 0);
    ctx.strokeStyle = i === 0 ? '#2f4a5e' : (i % 5 === 0 ? '#1f2a35' : '#151d26');
    ctx.beginPath(); ctx.moveTo(sx,0); ctx.lineTo(sx,h); ctx.stroke();
    if (i % 5 === 0) ctx.fillText((i*st) + ' m', sx + 3, h - 6);
  }
  for (let i = Math.floor(y0/st); i*st <= y1; i++){
    const [, sy] = toS(0, i*st);
    ctx.strokeStyle = i === 0 ? '#2f4a5e' : (i % 5 === 0 ? '#1f2a35' : '#151d26');
    ctx.beginPath(); ctx.moveTo(0,sy); ctx.lineTo(w,sy); ctx.stroke();
    if (i % 5 === 0 && i !== 0) ctx.fillText((i*st) + ' m', 4, sy - 3);
  }

  if (trail.length > 1){
    ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 2.5; ctx.lineJoin = 'round';
    ctx.beginPath();
    trail.forEach((p,i) => { const [sx,sy] = toS(p[0],p[1]); i ? ctx.lineTo(sx,sy) : ctx.moveTo(sx,sy); });
    ctx.stroke();
    ctx.fillStyle = 'rgba(34,211,238,.5)';
    for (const p of trail){ const [sx,sy] = toS(p[0],p[1]); ctx.beginPath(); ctx.arc(sx,sy,2,0,7); ctx.fill(); }
  }

  if (trail.length){
    const [sx,sy] = toS(trail[0][0], trail[0][1]);
    ctx.fillStyle = '#1f6f43'; ctx.strokeStyle = '#3fb950'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(sx,sy,8,0,7); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#d6ffe6'; ctx.font = 'bold 9px system-ui'; ctx.textAlign = 'center';
    ctx.fillText('S', sx, sy + 3); ctx.textAlign = 'left';
  }

  const [px,py] = toS(cur.x, cur.y), a = cur.h * Math.PI / 180;
  if (cur.walk){
    const t = (performance.now() % 1200) / 1200;
    ctx.strokeStyle = `rgba(63,185,80,${1-t})`; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(px,py,10 + t*18,0,7); ctx.stroke();
  }
  ctx.save(); ctx.translate(px,py); ctx.rotate(a);
  const g = ctx.createRadialGradient(0,0,0,0,0,60);
  g.addColorStop(0,'rgba(59,130,246,.35)'); g.addColorStop(1,'rgba(59,130,246,0)');
  ctx.fillStyle = g; ctx.beginPath(); ctx.moveTo(0,0);
  ctx.arc(0,0,60,-Math.PI/2 - 0.45,-Math.PI/2 + 0.45); ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#3b82f6'; ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.arc(0,0,9,0,7); ctx.fill(); ctx.stroke();
  ctx.fillStyle = '#fff'; ctx.beginPath();
  ctx.moveTo(0,-6); ctx.lineTo(4,3); ctx.lineTo(0,1); ctx.lineTo(-4,3); ctx.closePath(); ctx.fill();
  ctx.restore();

  $('sbar').style.width = (st * view.scale) + 'px';
  $('slabel').textContent = st + ' m';
  requestAnimationFrame(draw);
}

let drag = null;
cv.addEventListener('pointerdown', e => {
  drag = {x:e.clientX, y:e.clientY, cx:view.cx, cy:view.cy};
  cv.setPointerCapture(e.pointerId); follow = false; updFollow(); cv.style.cursor = 'grabbing';
});
cv.addEventListener('pointermove', e => {
  if (!drag) return;
  view.cx = drag.cx - (e.clientX - drag.x)/view.scale;
  view.cy = drag.cy + (e.clientY - drag.y)/view.scale;
});
cv.addEventListener('pointerup', () => { drag = null; cv.style.cursor = 'grab'; });
cv.addEventListener('wheel', e => { e.preventDefault(); zoom(e.deltaY < 0 ? 1.2 : 1/1.2); }, {passive:false});
function zoom(f){ view.scale = Math.min(300, Math.max(4, view.scale*f)); }
function updFollow(){ $('follow').className = follow ? 'on' : ''; }
function fit(){
  const xs = trail.map(p => p[0]).concat(cur.x), ys = trail.map(p => p[1]).concat(cur.y);
  const mnx = Math.min(...xs), mxx = Math.max(...xs), mny = Math.min(...ys), mxy = Math.max(...ys);
  view.cx = (mnx + mxx)/2; view.cy = (mny + mxy)/2;
  view.scale = Math.min(300, Math.max(4, Math.min(W()/(mxx - mnx + 4), H()/(mxy - mny + 4))));
  follow = false; updFollow();
}
$('zin').onclick = () => zoom(1.3);
$('zout').onclick = () => zoom(1/1.3);
$('fit').onclick = fit;
$('follow').onclick = () => { follow = !follow; updFollow(); };

$('reset').onclick = () => fetch('/reset').then(() => { view.cx = 0; view.cy = 0; follow = true; updFollow(); });
$('cal').onclick = () => fetch('/calibrate');
$('lenset').onclick = () => fetch('/set?len=' + $('len').value);
$('snap').onchange = () => fetch('/set?snap=' + $('snap').value);
$('fuse').onclick = () => fetch('/set?fuse=' + (curFuse ? 0 : 1));
$('magcal').onclick = () => fetch('/magcal');

async function poll(){
  try {
    const r = await fetch(`/pdr?from=${next}&s=${sess}`, {cache:'no-store'});
    const j = await r.json();
    if (j.s !== sess){ sess = j.s; trail = []; }
    for (const p of j.pts) trail.push(p);
    if (trail.length > 5000) trail.splice(0, trail.length - 5000);
    next = j.next;
    cur = {x:j.x, y:j.y, h:j.h, walk:j.walk};

    $('steps').textContent = j.steps;
    $('dist').textContent = j.dist.toFixed(1);
    $('hdg').textContent = Math.round(j.h);
    $('harrow').style.transform = `rotate(${j.h}deg)`;
    $('pos').textContent = `${j.x.toFixed(1)}, ${j.y.toFixed(1)}`;

    const s = $('status');
    if (!j.imu){ s.textContent = 'IMU not responding'; s.className = 'status cal'; }
    else if (j.cal){ s.textContent = 'Calibrating gyro, hold still'; s.className = 'status cal'; }
    else if (j.walk){ s.textContent = 'Walking'; s.className = 'status walk'; }
    else { s.textContent = 'Standing'; s.className = 'status'; }

    curFuse = j.fuse;
    const ms = $('magstat');
    if (!j.magok){ ms.textContent = 'Not detected'; ms.className = 'status cal'; }
    else if (j.mcal >= 0){ ms.textContent = `Calibrating: rotate, ${j.mcal}s left`; ms.className = 'status cal'; }
    else if (!j.fuse){ ms.textContent = 'Off, gyro only'; ms.className = 'status'; }
    else if (j.mag === 1){ ms.textContent = 'Fused with gyro'; ms.className = 'status walk'; }
    else if (j.mag === 2){ ms.textContent = 'Disturbed, gyro only'; ms.className = 'status cal'; }
    else { ms.textContent = 'Waiting for data'; ms.className = 'status'; }
    $('bval').textContent = j.b.toFixed(1);
    $('mhval').textContent = Math.round(j.mh);
    $('fuse').textContent = 'Fusion: ' + (j.fuse ? 'On' : 'Off');
    $('fuse').className = j.fuse ? 'on' : '';
    $('calbox').style.display = j.mcal >= 0 ? 'block' : 'none';
    ['spx','spy','spz'].forEach((id,i) => { $(id).style.width = Math.min(100, j.msp[i] / 90 * 100) + '%'; });
    $('mmsg').textContent = j.mmsg;

    if (document.activeElement !== $('len')) $('len').value = j.len.toFixed(2);
    if (document.activeElement !== $('snap')) $('snap').value = j.snap;
    online = true;
  } catch(e){ online = false; }
  $('dot').className = 'dot' + (online ? ' ok' : '');
  $('conn').textContent = online ? 'connected' : 'offline';
  setTimeout(poll, 150);
}

updFollow(); poll(); requestAnimationFrame(draw);
</script>
</body>
</html>
)HTML";

// ---------------- HTTP handlers ----------------
void handleRoot() {
  server.send(200, "text/html", PAGE);
}

void handlePDR() {
  unsigned long from = server.hasArg("from") ? strtoul(server.arg("from").c_str(), nullptr, 10) : 0;
  long s = server.hasArg("s") ? server.arg("s").toInt() : -1;
  if (s != (long)session) from = 0;
  unsigned long oldest = pathCount > MAXPTS ? pathCount - MAXPTS : 0;
  if (from < oldest) from = oldest;
  if (from > pathCount) from = pathCount;
  unsigned long to = pathCount;
  if (to - from > 300) to = from + 300;

  long left = -1;
  if (magCal) {
    unsigned long el = millis() - magCalStart;
    left = el >= MAGCAL_MS ? 0 : (long)((MAGCAL_MS - el) / 1000);
  }
  float sp[3] = {0, 0, 0};
  if (magCal) for (int i = 0; i < 3; i++) sp[i] = cmx[i] > cmn[i] ? cmx[i] - cmn[i] : 0;

  String j;
  j.reserve(500 + (to - from) * 24);
  j += "{\"s\":"; j += session;
  j += ",\"next\":"; j += to;
  j += ",\"x\":"; j += String(posX, 2);
  j += ",\"y\":"; j += String(posY, 2);
  j += ",\"h\":"; j += String(heading, 1);
  j += ",\"steps\":"; j += steps;
  j += ",\"dist\":"; j += String(distance, 2);
  j += ",\"len\":"; j += String(stepLength, 2);
  j += ",\"snap\":"; j += snapDeg;
  j += ",\"walk\":"; j += walking ? "true" : "false";
  j += ",\"cal\":"; j += calibrating ? "true" : "false";
  j += ",\"imu\":"; j += imuOk ? "true" : "false";
  j += ",\"magok\":"; j += magOk ? "true" : "false";
  j += ",\"mag\":"; j += magState;
  j += ",\"fuse\":"; j += fuseMag ? "true" : "false";
  j += ",\"b\":"; j += String(bNow, 1);
  j += ",\"mh\":"; j += String(magHeadingNow, 1);
  j += ",\"mcal\":"; j += left;
  j += ",\"msp\":["; j += String(sp[0], 0); j += ","; j += String(sp[1], 0); j += ","; j += String(sp[2], 0); j += "]";
  j += ",\"mmsg\":\""; j += magMsg; j += "\"";
  j += ",\"pts\":[";
  for (unsigned long i = from; i < to; i++) {
    if (i > from) j += ",";
    j += "["; j += String(pathX[i % MAXPTS], 2);
    j += ",";  j += String(pathY[i % MAXPTS], 2); j += "]";
  }
  j += "]}";
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(200, "application/json", j);
}

void handleReset() {
  resetPDR();
  server.send(200, "text/plain", "ok");
}

void handleCalibrate() {
  calibrating = true;
  calCount = 0;
  for (int i = 0; i < 3; i++) { calG[i] = 0; calA[i] = 0; }
  server.send(200, "text/plain", "ok");
}

void handleMagCal() {
  if (!magOk) { server.send(200, "text/plain", "no magnetometer"); return; }
  for (int i = 0; i < 3; i++) { cmn[i] = 1e9; cmx[i] = -1e9; }
  magCalStart = millis();
  magCal = true;
  snprintf(magMsg, sizeof(magMsg), "Rotate the sensor in every direction");
  server.send(200, "text/plain", "ok");
}

void handleSet() {
  if (server.hasArg("len")) {
    stepLength = constrain(server.arg("len").toFloat(), 0.3f, 1.2f);
    prefs.putFloat("len", stepLength);
  }
  if (server.hasArg("snap")) {
    int v = server.arg("snap").toInt();
    snapDeg = (v == 45 || v == 90) ? v : 0;
  }
  if (server.hasArg("fuse")) fuseMag = server.arg("fuse").toInt() != 0;
  server.send(200, "text/plain", "ok");
}

// ---------------- WiFi ----------------
void startWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("Connecting to WiFi");
  unsigned long t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 15000) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  if (WiFi.status() != WL_CONNECTED) {
    WiFi.disconnect(true);
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASS);
    Serial.printf("WiFi failed. Join hotspot %s (password %s)\n", AP_SSID, AP_PASS);
  }
  if (MDNS.begin("safeware")) MDNS.addService("http", "tcp", 80);
}

String pageURL() {
  IPAddress ip = (WiFi.getMode() == WIFI_AP) ? WiFi.softAPIP() : WiFi.localIP();
  return "http://" + ip.toString();
}

// ---------------- Main ----------------
void setup() {
  Serial.begin(115200);
  delay(500);

  prefs.begin("pdr", false);
  if (prefs.isKey("moff") && prefs.isKey("msc")) {
    prefs.getBytes("moff", magOffset, sizeof(magOffset));
    prefs.getBytes("msc", magScale, sizeof(magScale));
    Serial.println("Loaded magnetometer calibration from flash");
  }
  stepLength = prefs.getFloat("len", stepLength);

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);
  imuOk = initIMU();
  magOk = imuOk && initMag();
  if (!imuOk) Serial.println("IMU not responding. Check wiring.");
  else if (!magOk) Serial.println("Magnetometer not found. Running gyro only.");

  resetPDR();
  startWiFi();

  server.on("/", handleRoot);
  server.on("/pdr", handlePDR);
  server.on("/reset", handleReset);
  server.on("/calibrate", handleCalibrate);
  server.on("/magcal", handleMagCal);
  server.on("/set", handleSet);
  server.begin();

  Serial.println("Hold the sensor still: calibrating gyro...");
  lastUs = micros();
}

void loop() {
  server.handleClient();

  static unsigned long lastPrint = 0;
  if (millis() - lastPrint > 2000) {
    lastPrint = millis();
    Serial.printf("%s | steps %lu  x %.2f  y %.2f  hdg %.1f  mag %s B %.1f  %s\n",
                  pageURL().c_str(), steps, posX, posY, heading,
                  !magOk ? "none" : magCal ? "CAL" : magState == 1 ? "good" : magState == 2 ? "disturbed" : "wait",
                  bNow, calibrating ? "GYRO CAL" : (walking ? "walking" : "still"));
  }

  unsigned long nowUs = micros();
  if (nowUs - lastUs < 10000) return;     // 100 Hz
  float dt = (nowUs - lastUs) / 1e6f;
  lastUs = nowUs;
  if (dt > 0.1f) dt = 0.1f;

  float a[3], g[3];
  if (!readIMU(a, g)) {
    imuOk = false;
    static unsigned long lastInit = 0;
    if (millis() - lastInit > 1000) {
      lastInit = millis();
      imuOk = initIMU();
      if (imuOk) magOk = initMag();
    }
    return;
  }
  imuOk = true;

  if (magOk) processMag();
  if (magCal && millis() - magCalStart >= MAGCAL_MS) finishMagCal();

  if (calibrating) {
    for (int i = 0; i < 3; i++) { calG[i] += g[i]; calA[i] += a[i]; }
    if (++calCount >= CAL_SAMPLES) {
      for (int i = 0; i < 3; i++) {
        gBias[i] = calG[i] / CAL_SAMPLES;
        grav[i]  = calA[i] / CAL_SAMPLES;
        calG[i] = calA[i] = 0;
      }
      refAxis = 0;
      for (int i = 1; i < 3; i++) if (fabsf(grav[i]) < fabsf(grav[refAxis])) refAxis = i;
      refSet = false;
      calCount = 0;
      calibrating = false;
      Serial.printf("Gyro bias: %.2f %.2f %.2f dps\n", gBias[0], gBias[1], gBias[2]);
    }
    return;
  }

  updatePDR(a, g, dt);
}
