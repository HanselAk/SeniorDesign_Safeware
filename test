const int SDA_PIN = 21;
const int SCL_PIN = 22;

// Default magnetometer calibration. The web page's Calibrate button replaces
// these and saves them to flash.
float magOffset[3] = {-100.35, -255.51, -377.74};
float magScale[3]  = {1.367, 0.992, 0.793};

// PDR tuning
float stepLength = 0.70;                  // meters, adjustable on the page, saved to flash
int   snapDeg = 0;                        // 0 = off, 45 or 90
const float STEP_HI = 0.12;               // g, vertical accel peak that counts as a step
const float STEP_LO = -0.05;              // g, must dip below this before the next step
const unsigned long STEP_MIN_MS = 280;
const unsigned long WALK_TIMEOUT_MS = 1500;

// Magnetometer fusion tuning
const float K_MAG = 0.5;                  // drift correction speed (per second)
const float B_TOL = 0.20;                 // ignore mag if field strength changes more than 20%
const float DIP_TOL = 10.0;               // ignore mag if dip angle changes more than 10 degrees
const float MAX_TURN_RATE = 90.0;         // skip correction during fast turns (deg/s)
const unsigned long MAGCAL_MS = 30000;    // magnetometer calibration duration
// =================================================

#define MPU 0x68
#define MAG 0x0C
WebServer server(80);
Preferences prefs;

// IMU state
float gBias[3] = {0, 0, 0};
float grav[3]  = {0, 0, 1};
bool  imuOk = false;
bool  calibrating = true;
int   calCount = 0;
float calG[3] = {0, 0, 0}, calA[3] = {0, 0, 0};
const int CAL_SAMPLES = 200;
int   refAxis = 0;                        // most horizontal sensor axis, used for mag heading

// Magnetometer state
float asa[3] = {1, 1, 1};
bool  magOk = false;
bool  fuseMag = true;
float magV[3] = {0, 0, 0};
bool  magFresh = false;
bool  refSet = false;
float magRef = 0, bRef = 0, dipRef = 0;
int   magState = 0;                       // 0 no data, 1 good, 2 disturbed
float bNow = 0, magHeadingNow = 0;
bool  magCal = false;
unsigned long magCalStart = 0;
float cmn[3], cmx[3];
char  magMsg[48] = "";

// PDR state
float heading = 0;                        // degrees, 0 = facing at reset, clockwise positive
float posX = 0, posY = 0, distance = 0;
unsigned long steps = 0;
float avFilt = 0;
bool  armed = true;
unsigned long lastStepMs = 0;
bool  walking = false;
float stillMs = 0;

// Path history
const unsigned long MAXPTS = 1500;
float pathX[MAXPTS], pathY[MAXPTS];
unsigned long pathCount = 0;
unsigned long session = 0;

unsigned long lastUs = 0;

// ---------------- Helpers ----------------
float wrap360(float a) { a = fmodf(a, 360.0f); if (a < 0) a += 360.0f; return a; }
float wrap180(float a) { a = wrap360(a); if (a > 180.0f) a -= 360.0f; return a; }
float norm3(const float v[3]) { return sqrtf(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]); }

void writeReg(uint8_t a, uint8_t r, uint8_t v) {
  Wire.beginTransmission(a);
  Wire.write(r);
  Wire.write(v);
  Wire.endTransmission();
}

bool readRegs(uint8_t a, uint8_t r, uint8_t *buf, uint8_t n) {
  Wire.beginTransmission(a);
  Wire.write(r);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)a, (uint8_t)n) != n) return false;
  for (uint8_t i = 0; i < n; i++) buf[i] = Wire.read();
  return true;
}

// ---------------- Sensors ----------------
bool initIMU() {
  writeReg(MPU, 0x6B, 0x80); delay(100);  // reset
  writeReg(MPU, 0x6B, 0x01); delay(50);   // wake
  writeReg(MPU, 0x1A, 0x03);              // gyro low-pass ~41 Hz
  writeReg(MPU, 0x19, 0x09);              // 100 Hz
  writeReg(MPU, 0x1B, 0x08);              // gyro +/-500 dps
  writeReg(MPU, 0x1C, 0x08);              // accel +/-4 g
  writeReg(MPU, 0x1D, 0x03);              // accel low-pass ~44 Hz
  uint8_t who = 0;
  return readRegs(MPU, 0x75, &who, 1);
}

bool initMag() {
  writeReg(MPU, 0x6A, 0x00);              // internal I2C master off
  writeReg(MPU, 0x37, 0x02); delay(10);   // bypass: magnetometer on main bus
  writeReg(MAG, 0x0B, 0x01); delay(10);   // soft reset
  uint8_t wia = 0;
  if (!readRegs(MAG, 0x00, &wia, 1) || wia != 0x48) return false;
  writeReg(MAG, 0x0A, 0x00); delay(10);
  writeReg(MAG, 0x0A, 0x0F); delay(10);   // fuse ROM access
  uint8_t raw[3];
  readRegs(MAG, 0x10, raw, 3);
  for (int i = 0; i < 3; i++) asa[i] = (raw[i] - 128) * 0.5f / 128.0f + 1.0f;
  writeReg(MAG, 0x0A, 0x00); delay(10);
  writeReg(MAG, 0x0A, 0x16); delay(10);   // continuous 100 Hz, 16-bit
  return true;
}

bool readIMU(float a[3], float g[3]) {
  uint8_t d[14];
  if (!readRegs(MPU, 0x3B, d, 14)) return false;
  for (int i = 0; i < 3; i++) {
    a[i] = (int16_t)((d[i * 2] << 8) | d[i * 2 + 1]) / 8192.0f;
    g[i] = (int16_t)((d[8 + i * 2] << 8) | d[9 + i * 2]) / 65.5f;
  }
  return true;
}

bool readMagUT(float ut[3]) {
  uint8_t st1 = 0;
  if (!readRegs(MAG, 0x02, &st1, 1) || !(st1 & 0x01)) return false;
  uint8_t d[7];
  if (!readRegs(MAG, 0x03, d, 7)) return false;
  if (d[6] & 0x08) return false;          // overflow
  for (int i = 0; i < 3; i++)
    ut[i] = (int16_t)((d[i * 2 + 1] << 8) | d[i * 2]) * asa[i] * 0.15f;
  return true;
}

void processMag() {
  float ut[3];
  if (!readMagUT(ut)) return;
  if (magCal) {
    for (int i = 0; i < 3; i++) {
      if (ut[i] < cmn[i]) cmn[i] = ut[i];
      if (ut[i] > cmx[i]) cmx[i] = ut[i];
    }
    return;
  }
  float c[3];
  for (int i = 0; i < 3; i++) c[i] = (ut[i] - magOffset[i]) * magScale[i];
  // Align magnetometer axes with accel/gyro axes
  magV[0] = c[1];
  magV[1] = c[0];
  magV[2] = -c[2];
  magFresh = true;
}

void finishMagCal() {
  magCal = false;
  float r[3];
  for (int i = 0; i < 3; i++) r[i] = (cmx[i] - cmn[i]) / 2.0f;
  if (r[0] < 20 || r[1] < 20 || r[2] < 20) {
    snprintf(magMsg, sizeof(magMsg), "Not enough rotation. Kept old calibration.");
    return;
  }
  float avg = (r[0] + r[1] + r[2]) / 3.0f;
  for (int i = 0; i < 3; i++) {
    magOffset[i] = (cmx[i] + cmn[i]) / 2.0f;
    magScale[i] = avg / r[i];
  }
  prefs.putBytes("moff", magOffset, sizeof(magOffset));
  prefs.putBytes("msc", magScale, sizeof(magScale));
  refSet = false;
  snprintf(magMsg, sizeof(magMsg), "Saved. Field strength %.0f uT", avg);
  Serial.printf("Mag calibration saved. Offset %.1f %.1f %.1f  Scale %.3f %.3f %.3f\n",
                magOffset[0], magOffset[1], magOffset[2], magScale[0], magScale[1], magScale[2]);
}

// ---------------- PDR ----------------
void addPoint(float x, float y) {
  pathX[pathCount % MAXPTS] = x;
  pathY[pathCount % MAXPTS] = y;
  pathCount++;
}

void resetPDR() {
  posX = posY = 0;
  heading = 0;
  steps = 0;
  distance = 0;
  pathCount = 0;
  addPoint(0, 0);
  refSet = false;                         // re-anchor magnetometer to the new facing direction
  session++;
}

void updatePDR(float a[3], float gyro[3], float dt) {
  unsigned long now = millis();

  for (int i = 0; i < 3; i++) gyro[i] -= gBias[i];

  // Gravity estimate gives "up" in the sensor frame
  for (int i = 0; i < 3; i++) grav[i] += 0.02f * (a[i] - grav[i]);
  float gn = norm3(grav);
  if (gn < 0.5f) return;
  float u[3] = {grav[0] / gn, grav[1] / gn, grav[2] / gn};

  // Gyro heading
  float yawRate = gyro[0] * u[0] + gyro[1] * u[1] + gyro[2] * u[2];
  if (fabsf(yawRate) < 0.3f) yawRate = 0;
  heading = wrap360(heading - yawRate * dt);

  // Magnetometer correction
  if (magOk && magFresh && !magCal) {
    magFresh = false;
    float mn = norm3(magV);
    bNow = mn;
    if (mn > 5) {
      float d[3] = {-u[0], -u[1], -u[2]};                       // down
      float E[3] = {d[1] * magV[2] - d[2] * magV[1],             // east = down x mag
                    d[2] * magV[0] - d[0] * magV[2],
                    d[0] * magV[1] - d[1] * magV[0]};
      float en = norm3(E);
      if (en > 1e-3f) {
        for (int i = 0; i < 3; i++) E[i] /= en;
        float N[3] = {E[1] * d[2] - E[2] * d[1],                 // north = east x down
                      E[2] * d[0] - E[0] * d[2],
                      E[0] * d[1] - E[1] * d[0]};
        float mh = atan2f(E[refAxis], N[refAxis]) * RAD_TO_DEG;
        float dip = asinf(constrain((magV[0] * d[0] + magV[1] * d[1] + magV[2] * d[2]) / mn, -1.0f, 1.0f)) * RAD_TO_DEG;

        if (!refSet) {
          magRef = wrap360(mh - heading);
          bRef = mn;
          dipRef = dip;
          refSet = true;
        }
        magHeadingNow = wrap360(mh - magRef);
        bool good = fabsf(mn - bRef) < B_TOL * bRef && fabsf(dip - dipRef) < DIP_TOL;
        magState = good ? 1 : 2;
        if (good && fuseMag && fabsf(yawRate) < MAX_TURN_RATE) {
          heading = wrap360(heading + K_MAG * wrap180(magHeadingNow - heading) * dt);
        }
      }
    }
  }

  // Step detection
  float av = a[0] * u[0] + a[1] * u[1] + a[2] * u[2] - gn;
  avFilt += 0.3f * (av - avFilt);
  if (armed && avFilt > STEP_HI && now - lastStepMs > STEP_MIN_MS) {
    armed = false;
    lastStepMs = now;
    steps++;
    float h = heading;
    if (snapDeg > 0) h = roundf(h / snapDeg) * snapDeg;
    posX += stepLength * sinf(h * DEG_TO_RAD);
    posY += stepLength * cosf(h * DEG_TO_RAD);
    distance += stepLength;
    addPoint(posX, posY);
  }
  if (!armed && avFilt < STEP_LO) armed = true;
  walking = steps > 0 && (now - lastStepMs) < WALK_TIMEOUT_MS;

  // Slow gyro bias correction while still
  float an = norm3(a);
  float gyroNorm = norm3(gyro);
  if (fabsf(an - 1.0f) < 0.03f && gyroNorm < 2.0f && !walking) stillMs += dt * 1000;
  else stillMs = 0;
  if (stillMs > 1000) {
    for (int i = 0; i < 3; i++) gBias[i] += 0.002f * gyro[i];
  }
}

