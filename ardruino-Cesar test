#include <WiFi.h>
#include <HTTPClient.h>
#include <Wire.h>

// ================= YOUR SETTINGS =================
const char* WIFI_SSID = "Matteo";
const char* WIFI_PASS = "Lean165?";

const char* SERVER_URL =
    "http://172.20.10.12:5000/api/imu";

const char* API_TOKEN = "";
const char* DEVICE_ID = "esp32-01";

const int SDA_PIN = 21;
const int SCL_PIN = 22;

const unsigned long SEND_MS = 100;
// =================================================

// Wiring:
// MPU9250 VCC -> ESP32 3V3
// MPU9250 GND -> ESP32 GND
// MPU9250 SDA -> ESP32 GPIO21
// MPU9250 SCL -> ESP32 GPIO22
// MPU9250 AD0 -> GND
// MPU9250 NCS/CS, if present -> 3V3

#define MPU 0x68
#define MAG 0x0C

// Acceleration: g
// Gyroscope: degrees/second
// Magnetometer: microtesla
// Timestamp: microseconds
struct Sample {
  uint32_t us;
  float a[3];
  float g[3];
  float m[3];
  bool hasMag;
};

const uint32_t BUF_SIZE = 512;
const uint32_t MAX_BATCH = 60;

Sample buf[BUF_SIZE];
Sample batch[MAX_BATCH];

volatile uint32_t head = 0;
volatile uint32_t tail = 0;
volatile uint32_t dropped = 0;

portMUX_TYPE bufMux = portMUX_INITIALIZER_UNLOCKED;

volatile bool imuOk = false;
volatile bool magOk = false;

float asa[3] = {1, 1, 1};

uint32_t bootId = 0;
unsigned long lastUs = 0;

char body[MAX_BATCH * 96 + 192];

// ================= I2C HELPERS =================

void writeReg(uint8_t address, uint8_t reg, uint8_t value) {
  Wire.beginTransmission(address);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

bool readRegs(
    uint8_t address,
    uint8_t reg,
    uint8_t* buffer,
    uint8_t length) {

  Wire.beginTransmission(address);
  Wire.write(reg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  if (Wire.requestFrom(address, length) != length) {
    return false;
  }

  for (uint8_t i = 0; i < length; i++) {
    buffer[i] = Wire.read();
  }

  return true;
}

// ================= SENSOR SETUP =================

bool initIMU() {
  writeReg(MPU, 0x6B, 0x80);
  delay(100);

  writeReg(MPU, 0x6B, 0x01);
  delay(50);

  writeReg(MPU, 0x1A, 0x03);
  writeReg(MPU, 0x19, 0x09);
  writeReg(MPU, 0x1B, 0x08);  // Gyro +/-500 deg/s
  writeReg(MPU, 0x1C, 0x10);  // Accel +/-8 g
  writeReg(MPU, 0x1D, 0x03);

  uint8_t who = 0;

  if (!readRegs(MPU, 0x75, &who, 1)) {
    return false;
  }

  Serial.printf("IMU WHO_AM_I: 0x%02X\n", who);

  return who == 0x70 || who == 0x71 || who == 0x73;
}

bool initMag() {
  writeReg(MPU, 0x6A, 0x00);
  writeReg(MPU, 0x37, 0x02);
  delay(10);

  writeReg(MAG, 0x0B, 0x01);
  delay(10);

  uint8_t wia = 0;

  if (!readRegs(MAG, 0x00, &wia, 1) || wia != 0x48) {
    return false;
  }

  writeReg(MAG, 0x0A, 0x00);
  delay(10);

  writeReg(MAG, 0x0A, 0x0F);
  delay(10);

  uint8_t raw[3] = {};

  if (!readRegs(MAG, 0x10, raw, 3)) {
    writeReg(MAG, 0x0A, 0x00);
    return false;
  }

  for (int i = 0; i < 3; i++) {
    asa[i] = (raw[i] - 128) * 0.5f / 128.0f + 1.0f;
  }

  writeReg(MAG, 0x0A, 0x00);
  delay(10);

  writeReg(MAG, 0x0A, 0x16);
  delay(10);

  return true;
}

// ================= SENSOR READINGS =================

bool readIMU(float accel[3], float gyro[3]) {
  uint8_t data[14];

  if (!readRegs(MPU, 0x3B, data, 14)) {
    return false;
  }

  for (int i = 0; i < 3; i++) {
    int16_t rawAccel =
        (int16_t)((data[i * 2] << 8) | data[i * 2 + 1]);

    int16_t rawGyro =
        (int16_t)((data[8 + i * 2] << 8) |
                  data[9 + i * 2]);

    accel[i] = rawAccel / 4096.0f;
    gyro[i] = rawGyro / 65.5f;
  }

  return true;
}

bool readMagUT(float magnetometer[3]) {
  uint8_t status = 0;

  if (!readRegs(MAG, 0x02, &status, 1) ||
      !(status & 0x01)) {
    return false;
  }

  uint8_t data[7];

  if (!readRegs(MAG, 0x03, data, 7)) {
    return false;
  }

  if (data[6] & 0x08) {
    return false;
  }

  for (int i = 0; i < 3; i++) {
    int16_t raw =
        (int16_t)((data[i * 2 + 1] << 8) |
                  data[i * 2]);

    magnetometer[i] = raw * asa[i] * 0.15f;
  }

  return true;
}

// ================= SAMPLE BUFFER =================

void pushSample(const Sample& sample) {
  portENTER_CRITICAL(&bufMux);

  if (head - tail >= BUF_SIZE) {
    tail++;
    dropped++;
  }

  buf[head % BUF_SIZE] = sample;
  head++;

  portEXIT_CRITICAL(&bufMux);
}

// ================= JSON PAYLOAD =================

size_t buildBody(uint32_t count) {
  size_t len = snprintf(
      body,
      sizeof(body),
      "{\"device\":\"%s\",\"boot\":%lu,"
      "\"imu\":%s,\"mag\":%s,\"dropped\":%lu,\"s\":[",
      DEVICE_ID,
      (unsigned long)bootId,
      imuOk ? "true" : "false",
      magOk ? "true" : "false",
      (unsigned long)dropped);

  for (uint32_t i = 0;
       i < count && len < sizeof(body);
       i++) {

    const Sample& sample = batch[i];

    len += snprintf(
        body + len,
        sizeof(body) - len,
        "%s[%lu,%.4f,%.4f,%.4f,%.2f,%.2f,%.2f",
        i ? "," : "",
        (unsigned long)sample.us,
        sample.a[0],
        sample.a[1],
        sample.a[2],
        sample.g[0],
        sample.g[1],
        sample.g[2]);

    if (sample.hasMag && len < sizeof(body)) {
      len += snprintf(
          body + len,
          sizeof(body) - len,
          ",%.1f,%.1f,%.1f",
          sample.m[0],
          sample.m[1],
          sample.m[2]);
    }

    if (len < sizeof(body)) {
      len += snprintf(body + len, sizeof(body) - len, "]");
    }
  }

  if (len < sizeof(body)) {
    len += snprintf(body + len, sizeof(body) - len, "]}");
  }

  return len < sizeof(body) ? len : 0;
}

// ================= WIFI NETWORK TASK =================

void netTask(void*) {
  WiFiClient client;
  HTTPClient http;

  http.setReuse(true);

  unsigned long lastSend = 0;
  unsigned long lastReconnect = 0;
  unsigned long lastPrint = 0;

  int responseCode = 0;

  for (;;) {
    unsigned long now = millis();

    if (now - lastPrint >= 2000) {
      lastPrint = now;

      uint32_t buffered;
      uint32_t droppedCount;

      portENTER_CRITICAL(&bufMux);
      buffered = head - tail;
      droppedCount = dropped;
      portEXIT_CRITICAL(&bufMux);

      Serial.printf(
          "wifi %s | imu %s mag %s | last http %d | "
          "buffered %lu dropped %lu\n",
          WiFi.status() == WL_CONNECTED
              ? WiFi.localIP().toString().c_str()
              : "down",
          imuOk ? "ok" : "FAIL",
          magOk ? "ok" : "none",
          responseCode,
          (unsigned long)buffered,
          (unsigned long)droppedCount);
    }

    if (WiFi.status() != WL_CONNECTED) {
      if (now - lastReconnect >= 3000) {
        lastReconnect = now;
        WiFi.reconnect();
      }

      vTaskDelay(pdMS_TO_TICKS(250));
      continue;
    }

    if (now - lastSend < SEND_MS) {
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }

    lastSend = now;

    portENTER_CRITICAL(&bufMux);

    uint32_t start = tail;
    uint32_t count = head - tail;

    if (count > MAX_BATCH) {
      count = MAX_BATCH;
    }

    for (uint32_t i = 0; i < count; i++) {
      batch[i] = buf[(start + i) % BUF_SIZE];
    }

    portEXIT_CRITICAL(&bufMux);

    size_t len = buildBody(count);

    if (len == 0) {
      continue;
    }

    http.begin(client, SERVER_URL);
    http.setConnectTimeout(800);
    http.setTimeout(1000);
    http.addHeader("Content-Type", "application/json");

    if (API_TOKEN[0]) {
      http.addHeader("X-Safeware-Token", API_TOKEN);
    }

    responseCode = http.POST((uint8_t*)body, len);
    http.end();

    if (responseCode == 200) {
      portENTER_CRITICAL(&bufMux);

      if ((int32_t)(start + count - tail) > 0) {
        tail = start + count;
      }

      portEXIT_CRITICAL(&bufMux);
    }
  }
}

// ================= STARTUP =================

void setup() {
  Serial.begin(115200);
  delay(500);

  bootId = esp_random();

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);

  imuOk = initIMU();
  magOk = imuOk && initMag();

  if (!imuOk) {
    Serial.println(
        "MPU9250 not detected. Check wiring and WHO_AM_I.");
  } else if (!magOk) {
    Serial.println(
        "IMU connected, but magnetometer not found.");
  } else {
    Serial.println("MPU9250 and magnetometer connected!");
  }

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  xTaskCreatePinnedToCore(
      netTask,
      "net",
      8192,
      nullptr,
      1,
      nullptr,
      0);

  Serial.println(
      "Streaming to Jetson. Hold sensor still for calibration.");

  lastUs = micros();
}

// ================= MAIN SENSOR LOOP =================

void loop() {
  unsigned long nowUs = micros();

  if (nowUs - lastUs < 10000) {
    return;
  }

  lastUs = nowUs;

  if (!imuOk) {
    static unsigned long lastInit = 0;

    if (millis() - lastInit >= 1000) {
      lastInit = millis();
      imuOk = initIMU();
      magOk = imuOk && initMag();
    }

    return;
  }

  Sample sample = {};

  if (!readIMU(sample.a, sample.g)) {
    imuOk = false;
    magOk = false;
    return;
  }

  sample.us = nowUs;
  sample.hasMag = magOk && readMagUT(sample.m);

  pushSample(sample);
}
